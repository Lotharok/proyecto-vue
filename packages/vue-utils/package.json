{
   "name": "@pnpmworkspace/vue-utils",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "types": "./dist/index.d.ts"
      },
      "./i18n": {
         "import": "./dist/i18n/index.js",
         "types": "./dist/i18n/index.d.ts"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
   },
   "files": [
      "dist"
   ],
   "scripts": {
      "build": "pnpm format && pnpm lint && vue-tsc -b && vite build",
      "builddev": "pnpm format && pnpm lint && vue-tsc -b && vite build --mode development",
      "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
      "format": "prettier --write ."
   },
   "dependencies": {
      "@pnpmworkspace/types": "workspace:*"
   },
   "devDependencies": {
      "i18next": "catalog:",
      "i18next-http-backend": "catalog:",
      "i18next-vue": "catalog:",
      "vue": "catalog:"
   },
   "peerDependencies": {
      "i18next": "catalog:",
      "i18next-http-backend": "catalog:",
      "i18next-vue": "catalog:",
      "vue": "catalog:"
   }
}
