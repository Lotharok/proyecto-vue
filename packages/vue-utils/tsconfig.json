{
   "extends": "@vue/tsconfig/tsconfig.dom.json",
   "compilerOptions": {
      // Build optimization
      "incremental": true,
      "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
      "composite": true,

      // Target y Module - configuración para librerías modernas
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",

      // Module Resolution - CRÍTICO para librerías
      "moduleResolution": "bundler",
      "resolveJsonModule": true,

      // Emisión de archivos - la librería genera .js y .d.ts
      // IMPORTANTE: NO usar "noEmit" aquí porque esta es una librería
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "outDir": "./dist",
      "rootDir": "./src",

      // Interoperabilidad
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,

      // Vue y JSX
      "jsx": "preserve",
      "isolatedModules": true,
      "verbatimModuleSyntax": true,

      // Strict Mode - calidad de código
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "exactOptionalPropertyTypes": true,
      "noUncheckedIndexedAccess": true,

      // Paths - alias de importación
      "baseUrl": "./",
      "paths": {
         "@": ["./src"],
         "@/*": ["./src/*"]
      }
   },
   "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.tsx"],
   "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/*.story.vue"]
}
