{
   "extends": "@vue/tsconfig/tsconfig.dom.json",
   "compilerOptions": {
      // Build optimization
      "incremental": true,
      "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.{{kebabCase name}}.tsbuildinfo",
      "composite": true,

      // Target y Module - configuración para librerías Vue modernas
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",

      // Module Resolution - CRÍTICO para librerías con Vite
      "moduleResolution": "bundler",
      "resolveJsonModule": true,

      // Emisión de archivos
      // TypeScript: solo type-checking (Vite compila el código)
      // vite-plugin-dts: genera archivos .d.ts automáticamente
      "noEmit": true,
      "declaration": true,
      "declarationMap": true,
      "emitDeclarationOnly": false,

      // Interoperabilidad
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,

      // Vue y JSX
      "jsx": "preserve",
      "isolatedModules": true,
      "verbatimModuleSyntax": true,

      // Strict Mode - calidad de código
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "exactOptionalPropertyTypes": true,
      "noUncheckedIndexedAccess": true,

      // Paths - alias de importación
      "baseUrl": "./",
      "paths": {
         "@": ["./src"],
         "@/*": ["./src/*"]
      }
   },
   "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.tsx"],
   "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/*.story.vue"]
}
