{
   "name": "{{kebabCase projectName}}",
   "private": true,
   "packageManager": "pnpm@10.18.3",
   "description": "{{description}}",
   "scripts": {
{{#if includeTypes}}
      "lib-types": "pnpm --filter types",
{{/if}}
{{#if includeUtils}}
      "lib-utils": "pnpm --filter utils",
{{/if}}
      "lib-vue-utils": "pnpm --filter vue-utils",
      "build": "turbo build",
      "builddev": "turbo builddev",
      "lint": "turbo lint",
      "format": "turbo format"
   },
   "devDependencies": {
      "@eslint/js": "^9.38.0",
      "@types/node": "^24.8.1",
      "@vitejs/plugin-vue": "^6.0.1",
      "@vitest/coverage-v8": "3.2.4",
      "@vitest/ui": "^3.2.4",
      "@vue/tsconfig": "^0.8.1",
      "eslint": "^9.38.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-simple-import-sort": "^12.1.1",
      "eslint-plugin-vue": "^10.5.1",
      "globals": "^16.4.0",
      "prettier": "^3.6.2",
      "turbo": "^2.5.8",
      "typescript": "catalog:",
      "typescript-eslint": "^8.46.1",
      "vite": "^7.1.10",
      "vite-plugin-dts": "^4.5.4",
      "vitest": "^3.2.4",
      "vue-eslint-parser": "^10.2.0",
      "vue-tsc": "^3.1.1"
   }
}