{
   "name": "@pnpmworkspace/vue-utils",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "types": "./dist/index.d.ts"
      }
   },
   "files": [
      "dist"
   ],
   "scripts": {
      "build": "npm run format && npm run lint && vue-tsc -b && vite build",
      "builddev": "npm run format && npm run lint && vue-tsc -b && vite build --mode development",
      "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
      "format": "prettier --write ."
   },
   "dependencies": {},
   "peerDependencies": {
      "i18next": "catalog:",
      "i18next-http-backend": "catalog:",
      "i18next-vue": "catalog:",
      "vue": "catalog:"
   }
}