      "@vitest/ui": "^3.2.4",
      "@vue/tsconfig": "^0.8.1",
      "eslint": "^9.38.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-simple-import-sort": "^12.1.1",
      "eslint-plugin-vue": "^10.5.1",
      "globals": "^16.4.0",
      "prettier": "^3.6.2",
      "turbo": "^2.5.8",
      "typescript": "catalog:",
      "typescript-eslint": "^8.46.1",
      "vite": "^7.1.10",
      "vite-plugin-dts": "^4.5.4",
